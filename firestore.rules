rules_version = '2';

// Smart Attendance – Cloud Firestore security rules
//
// The first Administrator can only be the single verified e-mail address in
// bootstrapAdminEmail(), and only once (meta/bootstrap is write-once).
// See docs/SECURITY_SETUP.md.
//
// Roles (users/{uid}.role): admin | supervisor | worker | auditor
// Status (users/{uid}.status): pending_approval | active | inactive | suspended
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== CONFIGURE ======================================
    function bootstrapAdminEmail() { return 'krish.sep2006@gmail.com'; }
    // =====================================================================

    // ---------- identity helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userPath(u) { return /databases/$(database)/documents/users/$(u); }
    function hasProfile() { return signedIn() && exists(userPath(uid())); }
    function me() { return get(userPath(uid())).data; }
    function active() { return hasProfile() && me().status == 'active'; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function isStaff() { return active() && me().role in ['admin', 'supervisor']; }
    function canViewAll() { return active() && me().role in ['admin', 'supervisor', 'auditor']; }
    function isWorker() { return active() && me().role == 'worker'; }
    function isSupervisor() { return active() && me().role == 'supervisor'; }
    function isAuditor() { return active() && me().role == 'auditor'; }

    // Live positions and movement history (approved access policy):
    //   Administrator: whole district.  Supervisor: only workers assigned to
    //   them (records carry the worker's supervisorId).  Auditor: none (duty
    //   summaries and coverage reports only).  Worker: only their own.
    function canSeeTracking(d) {
      return isAdmin() || (isSupervisor() && d.get('supervisorId', null) == uid());
    }

    // ---------- write helpers ----------
    function incoming() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isServerTime(v) { return v == request.time; }

    // ---------- bootstrap ----------
    function bootstrapPath() { return /databases/$(database)/documents/meta/bootstrap; }
    function authorisedBootstrapUser() {
      return signedIn()
        && request.auth.token.email == bootstrapAdminEmail()
        && request.auth.token.email_verified == true;
    }

    // ---------- settings (business rules) ----------
    function settingsPath() { return /databases/$(database)/documents/settings/config; }
    function cfg(key, dflt) { return exists(settingsPath()) ? get(settingsPath()).data.get(key, dflt) : dflt; }

    // India Standard Time (UTC+05:30) – attendance dates are IST calendar days.
    function istNow() { return request.time + duration.value(330, 'm'); }
    function istMinutes() { return istNow().hours() * 60 + istNow().minutes(); }
    function isTodayIst(dateStr) {
      let p = dateStr.split('-');
      return p.size() == 3
        && int(p[0]) == istNow().year() && int(p[1]) == istNow().month() && int(p[2]) == istNow().day();
    }
    function lateAfterMinutes() {
      let p = string(cfg('lateAfter', '09:30')).split(':');
      return int(p[0]) * 60 + int(p[1]);
    }

    // A worker's self-submitted outcome must be consistent with the
    // verification results recorded in the same document.
    function validOutcome(d) {
      let face = d.checkIn.get('faceStatus', '');
      let geo = d.checkIn.get('geoStatus', '');
      let faceOk = face == 'verified' || (face == 'not_required' && cfg('requireFace', true) == false);
      let geoOk = geo == 'inside' || cfg('requireBoundary', true) == false;
      return d.status in ['pending_verification', 'rejected']
        || (d.status == 'late' && faceOk && geoOk)
        || (d.status == 'present' && faceOk && geoOk && istMinutes() <= lateAfterMinutes());
    }

    // =====================================================================
    match /meta/bootstrap {
      allow read: if signedIn();
      // Write-once. Only the authorised, verified e-mail; must atomically
      // make its own profile admin in the same batch.
      allow create: if authorisedBootstrapUser()
        && !exists(bootstrapPath())
        && incoming().adminUid == uid()
        && getAfter(userPath(uid())).data.role == 'admin';
      allow update, delete: if false;
    }

    // ---------- user profiles (NO biometric data here) ----------
    match /users/{userId} {
      allow read: if (signedIn() && userId == uid()) || canViewAll();

      allow create: if
        // Self sign-up: always a Field Worker with no privileged fields.
        // Workers are active immediately (no approval step). 'pending_approval'
        // is still accepted so older app versions keep working.
        (signedIn() && userId == uid()
          && incoming().keys().hasOnly(['name', 'email', 'phone', 'role', 'status', 'employeeId', 'category',
                                        'hasLogin', 'synthetic', 'faceEnrolled', 'createdAt'])
          && incoming().role == 'worker'
          && incoming().status in ['active', 'pending_approval']
          && incoming().email == request.auth.token.email
          && incoming().employeeId == ''
          && incoming().synthetic == false
          && incoming().faceEnrolled == false
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80)
        // Admin creates any profile; supervisors create worker records only.
        || isAdmin()
        || (isStaff() && incoming().role == 'worker');

      allow update: if
        // Admins manage everyone, but cannot change their own role/status (no self-lockout).
        (isAdmin() && !(userId == uid() && changed().hasAny(['role', 'status'])))
        // Supervisors manage workers but can never grant a role.
        || (isStaff() && resource.data.role == 'worker' && incoming().role == 'worker'
            && !changed().hasAny(['faceEnrolled']))
        // Bootstrap: the authorised verified e-mail promotes ITSELF once,
        // atomically with creating meta/bootstrap.
        || (signedIn() && userId == uid() && authorisedBootstrapUser()
            && !exists(bootstrapPath()) && existsAfter(bootstrapPath())
            && changed().hasOnly(['role', 'status'])
            && incoming().role == 'admin' && incoming().status == 'active')
        // Accounts created before approval was removed: a pending Field Worker
        // may activate ITSELF. Only from pending_approval, only the status
        // field, only to 'active', and only as a worker. Inactive/suspended
        // accounts (blocked by an admin) cannot use this.
        || (signedIn() && userId == uid()
            && resource.data.role == 'worker'
            && resource.data.status == 'pending_approval'
            && changed().hasOnly(['status'])
            && incoming().status == 'active'
            && incoming().role == 'worker')
        // Users may edit their own contact details only.
        || (signedIn() && userId == uid()
            && changed().hasOnly(['name', 'phone', 'updatedAt'])
            && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80)
        // Face-enrolled flag, only together with an actual template write.
        || ((active() && userId == uid() || isStaff() && resource.data.role == 'worker')
            && changed().hasOnly(['faceEnrolled', 'faceEnrolledAt', 'faceConsent', 'faceConsentAt'])
            && incoming().faceEnrolled == true
            && existsAfter(/databases/$(database)/documents/face_templates/$(userId)));

      allow delete: if isAdmin() && userId != uid();
    }

    // ---------- biometric templates (owner-read only) ----------
    match /face_templates/{userId} {
      // Only the person the template belongs to can read it. No list queries.
      allow get: if active() && userId == uid();
      allow list: if false;
      // Enrol once: by the worker, or by staff with the worker present.
      allow create: if (
          (active() && userId == uid())
          || (isStaff() && get(userPath(userId)).data.role == 'worker'))
        && incoming().keys().hasOnly(['embedding', 'dims', 'model', 'consent', 'enrolledBy', 'enrolledAt'])
        && incoming().embedding is list
        && incoming().embedding.size() == 192
        && incoming().dims == 192
        && incoming().consent == true
        && isServerTime(incoming().enrolledAt);
      allow update: if false;            // re-enrolment = admin delete + new enrolment
      allow delete: if isAdmin();
    }

    // ---------- reference data ----------
    match /boundaries/{id} {
      allow read: if active();
      allow write: if isStaff();
    }

    match /settings/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // ---------- attendance ----------
    match /attendance/{id} {
      // get: a worker may probe today's (possibly non-existent) own record.
      allow get: if canViewAll() || (signedIn() && (resource == null || resource.data.uid == uid()));
      allow list: if canViewAll() || (signedIn() && resource.data.uid == uid());

      allow create: if isStaff()
        || (isWorker()
            && incoming().uid == uid()
            && id == uid() + '_' + incoming().date
            && isTodayIst(incoming().date)
            && incoming().keys().hasOnly(['uid', 'name', 'employeeId', 'date', 'status', 'boundaryId',
                                          'checkIn', 'synthetic', 'createdAt'])
            && incoming().synthetic == false
            && incoming().boundaryId == me().get('boundaryId', null)
            && isServerTime(incoming().createdAt)
            && isServerTime(incoming().checkIn.time)
            && validOutcome(incoming()));

      // Workers can only add a check-out once; status/check-in are immutable for them.
      allow update: if isStaff()
        || (isWorker()
            && resource.data.uid == uid()
            && !('checkOut' in resource.data)
            && changed().hasOnly(['checkOut', 'updatedAt'])
            && isServerTime(incoming().checkOut.time)
            && isServerTime(incoming().updatedAt));

      allow delete: if isAdmin();
    }

    // ---------- verification audit log (append-only) ----------
    match /verifications/{id} {
      allow read: if canViewAll() || (signedIn() && resource.data.uid == uid());
      allow create: if active()
        && incoming().uid == uid()
        && incoming().type in ['face', 'location']
        && !('embedding' in incoming())
        && isServerTime(incoming().createdAt);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- live positions (latest point only, one document per person) ----------
    // Written by TrackingService (lib/services/tracking_service.dart) while the
    // worker is on field duty. Each write replaces the previous point; the
    // route is kept in worker_location_updates.
    function locationKeys() {
      return ['uid', 'name', 'lat', 'lng', 'accuracy', 'mocked', 'geoStatus', 'distanceToEdge',
              'boundaryId', 'supervisorId', 'sessionId', 'onDuty', 'updatedAt', 'synthetic'];
    }
    function validOwnLocation(userId) {
      return active() && userId == uid()
        && incoming().keys().hasOnly(locationKeys())
        && incoming().get('uid', userId) == userId
        && incoming().get('synthetic', false) == false
        && (!('lat' in incoming()) || (incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90))
        && (!('lng' in incoming()) || (incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180))
        && isServerTime(incoming().updatedAt);
    }
    match /locations/{userId} {
      allow read: if (signedIn() && userId == uid()) || canSeeTracking(resource.data);
      // A worker reports only their own position, with their OWN assigned
      // boundary and supervisor (so supervisors see only their own workers).
      allow create: if (isAdmin() && incoming().get('synthetic', false) == true)
        || (validOwnLocation(userId)
            && (!('boundaryId' in incoming()) || incoming().boundaryId == me().get('boundaryId', null))
            && (!('supervisorId' in incoming()) || incoming().supervisorId == me().get('supervisorId', null)));
      allow update: if (isAdmin() && incoming().get('synthetic', false) == true)
        || (validOwnLocation(userId)
            && (!changed().hasAny(['boundaryId']) || incoming().boundaryId == me().get('boundaryId', null))
            && (!changed().hasAny(['supervisorId']) || incoming().supervisorId == me().get('supervisorId', null)));
      allow delete: if isAdmin();
    }

    // ---------- field-duty sessions (one per Start duty -> Stop duty) ----------
    // Written by TrackingService. Holds no coordinates, so auditors may read it
    // as a duty record.
    function validTotals() {
      return incoming().pointCount is int && incoming().pointCount >= resource.data.get('pointCount', 0)
        && incoming().insideCount is int && incoming().insideCount >= 0
        && incoming().insideCount <= incoming().pointCount
        && incoming().distanceM is number && incoming().distanceM >= resource.data.get('distanceM', 0);
    }
    match /tracking_sessions/{sessionId} {
      allow read: if (signedIn() && resource.data.uid == uid()) || canSeeTracking(resource.data) || isAuditor();

      // A worker starts duty for themself, today, in their own assigned area
      // and under their own supervisor, with location consent recorded.
      allow create: if (isAdmin() && incoming().get('synthetic', false) == true)
        || (isWorker()
            && incoming().keys().hasOnly(['uid', 'name', 'date', 'boundaryId', 'supervisorId', 'status', 'consent',
                                          'pointCount', 'insideCount', 'distanceM', 'synthetic', 'startedAt'])
            && incoming().uid == uid()
            && incoming().name is string && incoming().name.size() <= 80
            && isTodayIst(incoming().date)
            && incoming().boundaryId == me().get('boundaryId', null)
            && incoming().supervisorId == me().get('supervisorId', null)
            && incoming().status == 'active'
            && incoming().consent == true
            && incoming().pointCount == 0 && incoming().insideCount == 0 && incoming().distanceM == 0
            && incoming().synthetic == false
            && isServerTime(incoming().startedAt));

      allow update: if
        // Owner: running totals while on duty (never decreasing).
        (signedIn() && resource.data.uid == uid() && resource.data.status == 'active'
          && changed().hasOnly(['pointCount', 'insideCount', 'distanceM', 'lastPointAt'])
          && validTotals())
        // Owner: end the session (once; it can never be reopened).
        || (signedIn() && resource.data.uid == uid() && resource.data.status == 'active'
          && changed().hasOnly(['status', 'endedAt', 'endReason', 'pointCount', 'insideCount', 'distanceM', 'lastPointAt'])
          && incoming().status == 'ended'
          && isServerTime(incoming().endedAt)
          && incoming().endReason in ['stopped_by_worker', 'checked_out', 'signed_out', 'auto_closed']
          && validTotals())
        // Admin, or the worker's own supervisor: close a session left open.
        || ((isAdmin() || (isSupervisor() && resource.data.get('supervisorId', null) == uid()))
          && resource.data.status == 'active'
          && changed().hasOnly(['status', 'endedAt', 'endReason', 'endedBy'])
          && incoming().status == 'ended'
          && incoming().endedBy == uid()
          && isServerTime(incoming().endedAt));

      allow delete: if isAdmin();   // retention clean-up only
    }

    // ---------- movement history (route points) ----------
    // Written by TrackingService (kind start/track/stop) and by the activity
    // form (kind activity, saved together with the activity and its photos).
    function pointKeys() {
      return ['uid', 'sessionId', 'supervisorId', 'boundaryId', 'date', 'kind', 'activityId', 'lat', 'lng',
              'accuracy', 'speed', 'mocked', 'geoStatus', 'distanceToEdge', 'gpsTime', 'synthetic', 'createdAt'];
    }
    function sessionOf(id) { return get(/databases/$(database)/documents/tracking_sessions/$(id)).data; }
    function validPoint(d) {
      return d.keys().hasOnly(pointKeys())
        && d.uid == uid()
        && d.synthetic == false
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.accuracy is number && d.accuracy >= 0
        && d.mocked is bool
        && d.gpsTime is timestamp
        && d.date is string
        && isServerTime(d.createdAt);
    }
    match /worker_location_updates/{pointId} {
      allow read: if (signedIn() && resource.data.uid == uid()) || canSeeTracking(resource.data);

      allow create: if (isAdmin() && incoming().get('synthetic', false) == true)
        || (isWorker() && validPoint(incoming())
            && (
              // Route point: only into the worker's OWN session while it is
              // active, copying that session's area, supervisor and date.
              (incoming().kind in ['start', 'track', 'stop']
                && !('activityId' in incoming())
                && incoming().sessionId is string
                && sessionOf(incoming().sessionId).uid == uid()
                && sessionOf(incoming().sessionId).status == 'active'
                && incoming().boundaryId == sessionOf(incoming().sessionId).boundaryId
                && incoming().supervisorId == sessionOf(incoming().sessionId).supervisorId
                && incoming().date == sessionOf(incoming().sessionId).date)
              // Activity point: saved in the same batch as the worker's own
              // activity, today, with their own area and supervisor.
              || (incoming().kind == 'activity'
                && incoming().activityId is string
                && getAfter(/databases/$(database)/documents/activities/$(incoming().activityId)).data.uid == uid()
                && incoming().boundaryId == me().get('boundaryId', null)
                && incoming().supervisorId == me().get('supervisorId', null)
                && isTodayIst(incoming().date)
                && (incoming().get('sessionId', null) == null || sessionOf(incoming().sessionId).uid == uid()))
            ));

      allow update: if false;        // history is never edited
      allow delete: if isAdmin();    // retention clean-up only
    }

    // ---------- panchayat coverage reports ----------
    // Saved by administrators from the Field coverage screen: one document per
    // panchayat per day, totals only (no personal positions).
    match /panchayat_coverage/{coverageId} {
      allow read: if isAdmin() || isAuditor();
      allow create, update: if isAdmin()
        && incoming().keys().hasOnly(['boundaryId', 'date', 'name', 'block', 'panchayat', 'sessions', 'workers',
                                      'points', 'insidePoints', 'distanceM', 'covered', 'synthetic',
                                      'generatedBy', 'generatedAt'])
        && coverageId == incoming().boundaryId + '_' + incoming().date
        && incoming().generatedBy == uid()
        && isServerTime(incoming().generatedAt);
      allow delete: if isAdmin();
    }

    // ---------- tasks ----------
    match /tasks/{id} {
      allow get: if canViewAll() || (signedIn() && (resource == null || resource.data.assignedTo == uid()));
      allow list: if canViewAll() || (signedIn() && resource.data.assignedTo == uid());
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (isWorker()
            && resource.data.assignedTo == uid()
            && changed().hasOnly(['status', 'updatedAt'])
            && (incoming().status == resource.data.status
                || (resource.data.status == 'assigned' && incoming().status == 'in_progress')
                || (resource.data.status in ['assigned', 'in_progress'] && incoming().status == 'submitted')));
    }

    // ---------- field activities and photo evidence metadata ----------
    // Photo files live in Cloud Storage (storage.rules) at
    //   evidence/{uid}/{activityId}/{0|1|2}.jpg   (lib/services/evidence_storage.dart)
    // and the activity stores only those paths in `images`, in upload order.
    // A worker may reference ONLY their own photos for THIS activity, so they
    // cannot attach another worker's (or another activity's) evidence.
    function evidencePath(activityId, i) {
      return 'evidence/' + uid() + '/' + activityId + '/' + string(i) + '.jpg';
    }
    function validEvidence(imgs, activityId) {
      return imgs is list && imgs.size() <= 3
        && (imgs.size() < 1 || imgs[0] == evidencePath(activityId, 0))
        && (imgs.size() < 2 || imgs[1] == evidencePath(activityId, 1))
        && (imgs.size() < 3 || imgs[2] == evidencePath(activityId, 2));
    }
    match /activities/{id} {
      allow read: if canViewAll() || (signedIn() && resource.data.uid == uid());
      // Workers submit through the camera/activity form (lib/screens/common/activity_form.dart),
      // which is opened only from one of their assigned tasks.
      allow create: if isStaff()
        || (isWorker()
            && incoming().keys().hasOnly(['taskId', 'taskTitle', 'uid', 'name', 'visitType', 'description',
                                          'measurement', 'lat', 'lng', 'accuracy', 'geoStatus', 'mocked',
                                          'sessionId', 'images', 'reviewStatus', 'synthetic', 'createdAt'])
            && incoming().uid == uid()
            && incoming().reviewStatus == 'pending'
            && incoming().synthetic == false
            && isServerTime(incoming().createdAt)
            && validEvidence(incoming().get('images', null), id)
            && incoming().taskId is string
            && get(/databases/$(database)/documents/tasks/$(incoming().taskId)).data.assignedTo == uid());
      allow update: if isStaff() && changed().hasOnly(['reviewStatus', 'reviewNote', 'reviewedBy', 'reviewedAt']);
      allow delete: if isAdmin();
    }

    // ---------- alerts ----------
    match /alerts/{id} {
      allow get: if canViewAll() || (signedIn() && (resource == null || resource.data.uid == uid()));
      allow list: if canViewAll() || (signedIn() && resource.data.uid == uid());
      // Workers can only raise system alerts about themselves; never resolve them.
      allow create: if isStaff()
        || (active()
            && incoming().uid == uid()
            && incoming().status == 'open'
            && incoming().synthetic == false
            && incoming().type in ['face_failed', 'outside_boundary', 'mock_location', 'late_checkin', 'low_accuracy']
            && isServerTime(incoming().createdAt));
      allow update: if isStaff() && changed().hasOnly(['status', 'resolution', 'resolvedBy', 'resolvedAt']);
      allow delete: if isAdmin();
    }

    // ---------- audit trail (append-only) ----------
    match /audit_logs/{id} {
      allow read: if canViewAll();
      allow create: if signedIn() && incoming().actorUid == uid() && isServerTime(incoming().createdAt);
      allow update, delete: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
