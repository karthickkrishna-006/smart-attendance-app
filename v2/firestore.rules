rules_version = '2';

// Smart Attendance v2 — Phase 4 (Foundation) security rules.
//
// Access is decided HERE, never only by the app's menus. Collections:
//   accounts/{uid}                   one per signed-in person
//   roleAssignments/{uid}__{role}    a role over areas (and an organisation)
//   preregistrations/{email}         people added in advance (no approval step)
//   areas/{id}                       district > block > zone > panchayat > location
//   organisations/{id}               the department and third-party firms
//   hierarchyLevels/{roleKey}        configurable titles for each role
//   config/app                       switches (open sign-up, policy options)
//   meta/bootstrap                   proof that the first administrator exists
//   auditLog/{id}                    append-only record of privileged actions
//
// Privileged writes (roles, registrations, configuration, master data) must be
// accompanied, in the same batch, by an auditLog entry naming that write; the
// write is refused otherwise, so an administrator cannot change access silently.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function incoming() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // E-mail from the sign-in token, lower case. Only verified addresses count
    // (Google accounts are always verified; e-mail/password must be confirmed).
    function verifiedEmail() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function emailKey() { return request.auth.token.email.lower(); }

    // The first administrator. Kept here, on the server side, never in the app.
    function bootstrapEmail() { return 'krish.sep2006@gmail.com'; }

    function accountActive() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(uid()))
        && get(/databases/$(database)/documents/accounts/$(uid())).data.status == 'active';
    }
    function assignment(role) { return get(/databases/$(database)/documents/roleAssignments/$(uid() + '__' + role)); }
    function hasRole(role) {
      return accountActive()
        && exists(/databases/$(database)/documents/roleAssignments/$(uid() + '__' + role))
        && assignment(role).data.active == true;
    }
    function isSysAdmin() { return hasRole('sys_admin'); }
    function isAuditor() { return hasRole('auditor'); }
    function isOrgAdminOf(orgId) {
      return orgId is string && hasRole('org_admin') && assignment('org_admin').data.orgId == orgId;
    }

    function roles() {
      return ['collector', 'officer', 'zonal_secretary', 'supervisor', 'org_admin', 'worker', 'auditor', 'sys_admin'];
    }
    // Job titles (lib/domain/designations.dart). null = none.
    function designationOk(d) {
      return d == null || d in ['thoomai_kavalar', 'oht_operator', 'mnp', 'vp_secretary', 'zonal_dy_bdo',
                                'dy_bdo_panchayats', 'bdo_village', 'dy_bdo_regular', 'bdo_block', 'district_monitor'];
    }

    // The write must come with auditLog/{incoming().auditId}, written in the
    // same batch by this person, naming this exact target. The entry must be
    // NEW in this batch, so an old entry cannot be reused for a later change.
    function audited(target) {
      return incoming().auditId is string
        && !exists(/databases/$(database)/documents/auditLog/$(incoming().auditId))
        && existsAfter(/databases/$(database)/documents/auditLog/$(incoming().auditId))
        && getAfter(/databases/$(database)/documents/auditLog/$(incoming().auditId)).data.actorUid == uid()
        && getAfter(/databases/$(database)/documents/auditLog/$(incoming().auditId)).data.target == target;
    }

    function config() { return get(/databases/$(database)/documents/config/app).data; }
    function openSignUp() { return exists(/databases/$(database)/documents/config/app) && config().get('openWorkerSignUp', false) == true; }

    function prereg() { return get(/databases/$(database)/documents/preregistrations/$(emailKey())); }
    function hasPrereg() { return verifiedEmail() && exists(/databases/$(database)/documents/preregistrations/$(emailKey())); }

    // -------------------------------------------------------------- accounts
    match /accounts/{accountId} {
      allow get: if (signedIn() && accountId == uid()) || isSysAdmin();
      allow list: if isSysAdmin();

      // Own account only. The organisation and employee ID come from the
      // person's pre-registration when there is one; otherwise none.
      allow create: if signedIn() && accountId == uid()
        && incoming().keys().hasOnly(['email', 'displayName', 'phone', 'employeeId', 'orgId', 'status', 'language', 'createdAt', 'lastLoginAt'])
        && incoming().email == request.auth.token.email
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && ((hasPrereg()
              && incoming().get('orgId', null) == prereg().data.get('orgId', null)
              && incoming().get('employeeId', null) == prereg().data.get('employeeId', null))
            || (!hasPrereg()
              && incoming().get('orgId', null) == null && incoming().get('employeeId', null) == null));

      allow update: if
        // The person: contact details and preferences only.
        (signedIn() && accountId == uid()
          && changed().hasOnly(['displayName', 'phone', 'language', 'lastLoginAt']))
        // The System administrator: switch an account on or off (audited).
        || (isSysAdmin() && accountId != uid()
          && changed().hasOnly(['status', 'auditId'])
          && incoming().status in ['active', 'disabled']
          && audited('accounts/' + accountId));

      allow delete: if false;
    }

    // ------------------------------------------------------- role assignments
    // Audit entry id for deleting one role grant: del_<assignmentId>_<grantedAt ms>.
    function deletionAuditId(assignmentId) {
      return 'del_' + assignmentId + '_' + string(resource.data.grantedAt.toMillis());
    }

    match /roleAssignments/{assignmentId} {
      allow get: if (signedIn() && resource.data.uid == uid()) || isSysAdmin();
      allow list: if (signedIn() && resource.data.uid == uid()) || isSysAdmin();

      function shapeOk() {
        return incoming().keys().hasOnly(['uid', 'role', 'areaIds', 'orgId', 'active', 'source', 'grantedBy', 'grantedAt', 'auditId', 'designation'])
          && incoming().role in roles()
          && designationOk(incoming().get('designation', null))
          && assignmentId == incoming().uid + '__' + incoming().role
          && incoming().areaIds is list && incoming().areaIds.size() <= 15
          && incoming().active == true
          && incoming().grantedAt == request.time
          && audited('roleAssignments/' + assignmentId);
      }

      allow create: if shapeOk() && (
        // 1. The System administrator grants a role (any role, audited).
        (isSysAdmin() && incoming().source == 'admin' && incoming().grantedBy == uid())

        // 2. A pre-registered person claims exactly what was prepared for them,
        //    in the same batch that marks the pre-registration claimed.
        || (hasPrereg() && incoming().uid == uid()
            && incoming().source == 'preregistration'
            && prereg().data.get('claimedBy', null) == null
            && getAfter(/databases/$(database)/documents/preregistrations/$(emailKey())).data.claimedBy == uid()
            && incoming().role == prereg().data.role
            && incoming().areaIds == prereg().data.areaIds
            && incoming().get('orgId', null) == prereg().data.get('orgId', null)
            && incoming().get('designation', null) == prereg().data.get('designation', null)
            && incoming().grantedBy == prereg().data.createdBy)

        // 3. Open sign-up (only when switched on): a field worker with no area
        //    and no organisation until an administrator assigns them.
        || (openSignUp() && incoming().uid == uid()
            && incoming().source == 'open_signup'
            && incoming().role == 'worker'
            && incoming().areaIds.size() == 0
            && incoming().get('orgId', null) == null
            && incoming().grantedBy == uid())

        // 4. One-time bootstrap of the first administrator, by the configured
        //    e-mail only, together with meta/bootstrap in the same batch.
        || (verifiedEmail() && emailKey() == bootstrapEmail()
            && incoming().uid == uid()
            && incoming().role == 'sys_admin'
            && incoming().source == 'bootstrap'
            && incoming().grantedBy == uid()
            && !exists(/databases/$(database)/documents/meta/bootstrap)
            && existsAfter(/databases/$(database)/documents/meta/bootstrap))
      );

      // Only the System administrator changes a role's areas, organisation or
      // on/off state (audited). Who holds it and which role it is never change.
      allow update: if isSysAdmin()
        && changed().hasOnly(['areaIds', 'orgId', 'active', 'auditId', 'designation'])
        && designationOk(incoming().get('designation', null))
        && incoming().areaIds is list && incoming().areaIds.size() <= 15
        && incoming().active is bool
        && audited('roleAssignments/' + assignmentId);

      // The System administrator may delete someone else's role. The deletion
      // must be recorded in the audit log in the same batch, under an id
      // derived from this exact grant, so it can never go unrecorded.
      allow delete: if isSysAdmin()
        && resource.data.uid != uid()
        && existsAfter(/databases/$(database)/documents/auditLog/$(deletionAuditId(assignmentId)))
        && getAfter(/databases/$(database)/documents/auditLog/$(deletionAuditId(assignmentId))).data.actorUid == uid()
        && getAfter(/databases/$(database)/documents/auditLog/$(deletionAuditId(assignmentId))).data.target == 'roleAssignments/' + assignmentId;
    }

    // ------------------------------------------------------- pre-registrations
    match /preregistrations/{key} {
      allow get: if isSysAdmin()
        || (resource != null && isOrgAdminOf(resource.data.get('orgId', null)))
        || (verifiedEmail() && key == emailKey());
      allow list: if isSysAdmin() || (resource.data.get('orgId', null) != null && isOrgAdminOf(resource.data.orgId));

      function preregShape() {
        return incoming().keys().hasOnly(['email', 'name', 'employeeId', 'orgId', 'role', 'areaIds', 'createdBy', 'createdAt', 'auditId', 'designation'])
          && key == incoming().email
          && incoming().email == incoming().email.lower()
          && incoming().role in roles()
          && designationOk(incoming().get('designation', null))
          && incoming().areaIds is list && incoming().areaIds.size() <= 15
          && incoming().createdBy == uid()
          && incoming().createdAt == request.time
          && audited('preregistrations/' + key);
      }

      allow create: if preregShape() && (
        isSysAdmin()
        // Organisation admins add field workers to their own organisation only.
        || (isOrgAdminOf(incoming().get('orgId', null)) && incoming().role == 'worker')
      );

      allow update: if
        // The person claims it (once), in the batch that creates their role.
        (verifiedEmail() && key == emailKey()
          && resource.data.get('claimedBy', null) == null
          && changed().hasOnly(['claimedBy', 'claimedAt'])
          && incoming().claimedBy == uid()
          && incoming().claimedAt == request.time
          && existsAfter(/databases/$(database)/documents/roleAssignments/$(uid() + '__' + resource.data.role)))
        // An administrator edits an unclaimed one (audited).
        || (resource.data.get('claimedBy', null) == null
          && (isSysAdmin() || (isOrgAdminOf(resource.data.get('orgId', null)) && incoming().role == 'worker'
                               && incoming().get('orgId', null) == resource.data.orgId))
          && changed().hasOnly(['name', 'employeeId', 'areaIds', 'role', 'orgId', 'auditId', 'designation'])
          && incoming().role in roles()
          && designationOk(incoming().get('designation', null))
          && audited('preregistrations/' + key));

      // The System administrator removes anyone (their roles are deleted, audited,
      // in the same action); organisation admins only people not yet signed in.
      allow delete: if isSysAdmin()
        || (resource.data.get('claimedBy', null) == null && isOrgAdminOf(resource.data.get('orgId', null)));
    }

    // ------------------------------------------------------------ master data
    match /areas/{areaId} {
      allow read: if signedIn();
      // The path runs from the district down to this node; a child's path is
      // its parent's path plus its own id, so scope checks stay consistent.
      allow create, update: if isSysAdmin()
        && incoming().keys().hasOnly(['name', 'level', 'parentId', 'path', 'provisional', 'auditId'])
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 120
        && incoming().level in ['district', 'block', 'zone', 'panchayat', 'habitation', 'location']
        && incoming().provisional is bool
        && ((incoming().level == 'district'
              && incoming().get('parentId', null) == null && incoming()['path'] == [areaId])
            || (incoming().level != 'district'
              && incoming().parentId is string
              && incoming()['path'] == get(/databases/$(database)/documents/areas/$(incoming().parentId)).data['path'].concat([areaId])))
        && audited('areas/' + areaId);
      allow delete: if false;
    }

    match /organisations/{orgId} {
      allow read: if signedIn();
      allow create, update: if isSysAdmin()
        && incoming().keys().hasOnly(['name', 'type', 'active', 'auditId'])
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 120
        && incoming().type in ['department', 'third_party']
        && incoming().active is bool
        && audited('organisations/' + orgId);
      allow delete: if false;
    }

    match /hierarchyLevels/{roleKey} {
      allow read: if signedIn();
      allow create, update: if isSysAdmin()
        && roleKey in roles()
        && incoming().keys().hasOnly(['title', 'auditId'])
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 60
        && audited('hierarchyLevels/' + roleKey);
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow create, update: if isSysAdmin() && docId == 'app'
        && incoming().keys().hasOnly(['openWorkerSignUp', 'supervisorsMayCreateTasks', 'collectorMayAssignTasks', 'auditId'])
        && incoming().get('openWorkerSignUp', false) is bool
        && incoming().get('supervisorsMayCreateTasks', false) is bool
        && incoming().get('collectorMayAssignTasks', false) is bool
        && audited('config/app');
      allow delete: if false;
    }

    match /meta/bootstrap {
      allow get: if signedIn();
      allow create: if verifiedEmail() && emailKey() == bootstrapEmail()
        && incoming().keys().hasOnly(['uid', 'email', 'at'])
        && incoming().uid == uid()
        && incoming().email == emailKey()
        && incoming().at == request.time
        && existsAfter(/databases/$(database)/documents/roleAssignments/$(uid() + '__sys_admin'));
      allow update, delete: if false;
    }

    // -------------------------------------------------------------- audit log
    match /auditLog/{entryId} {
      allow read: if isSysAdmin() || isAuditor();
      allow create: if signedIn()
        && incoming().keys().hasOnly(['actorUid', 'actorEmail', 'action', 'target', 'details', 'at'])
        && incoming().actorUid == uid()
        && incoming().get('actorEmail', null) == request.auth.token.get('email', null)
        && incoming().action is string && incoming().action.size() > 0 && incoming().action.size() <= 64
        && incoming().target is string && incoming().target.size() <= 200
        && incoming().at == request.time;
      allow update, delete: if false;   // append-only
    }

    // ------------------------------------------------- shared scope helpers
    function istNow() { return request.time + duration.value(330, 'm'); }
    function sameIstDay(parts, t) {
      return int(parts[0]) == t.year() && int(parts[1]) == t.month() && int(parts[2]) == t.day();
    }
    // Today or yesterday in India time: yesterday allows a check-in saved
    // offline in the evening to upload the next morning.
    function isRecentIstDate(dateStr) {
      let parts = dateStr.split('-');
      return parts.size() == 3
        && (sameIstDay(parts, istNow()) || sameIstDay(parts, istNow() - duration.value(1, 'd')));
    }
    // True when one of the officer's area ids (at most 15, enforced on every
    // role) appears in the record's area path. Each check is "<id> in <list>",
    // which Firestore can prove for a query filtered with
    // where('areaPath', 'array-contains', <id>). (A hasAny() comparison
    // against array-contains-any cannot be proven, so such queries were
    // refused.)
    function inAreas(ids, recordAreaPath) {
      return (ids.size() > 0 && ids[0] in recordAreaPath)
        || (ids.size() > 1 && ids[1] in recordAreaPath)
        || (ids.size() > 2 && ids[2] in recordAreaPath)
        || (ids.size() > 3 && ids[3] in recordAreaPath)
        || (ids.size() > 4 && ids[4] in recordAreaPath)
        || (ids.size() > 5 && ids[5] in recordAreaPath)
        || (ids.size() > 6 && ids[6] in recordAreaPath)
        || (ids.size() > 7 && ids[7] in recordAreaPath)
        || (ids.size() > 8 && ids[8] in recordAreaPath)
        || (ids.size() > 9 && ids[9] in recordAreaPath)
        || (ids.size() > 10 && ids[10] in recordAreaPath)
        || (ids.size() > 11 && ids[11] in recordAreaPath)
        || (ids.size() > 12 && ids[12] in recordAreaPath)
        || (ids.size() > 13 && ids[13] in recordAreaPath)
        || (ids.size() > 14 && ids[14] in recordAreaPath);
    }
    function coversPath(role, recordAreaPath) {
      return hasRole(role) && inAreas(assignment(role).data.areaIds, recordAreaPath);
    }
    // Officers see records inside their areas; the Collector the whole district;
    // organisation admins their own organisation; auditors history.
    function officerSees(d) {
      return hasRole('collector')
        || coversPath('officer', d.areaPath)
        || coversPath('zonal_secretary', d.areaPath)
        || coversPath('supervisor', d.areaPath)
        || (d.get('orgId', null) != null && isOrgAdminOf(d.orgId))
        || isAuditor();
    }

    // -------------------------------------------------------------- geofences
    // A circle (centre + radius) or one polygon ring, tied to an area; the
    // area path is copied so attendance inside it carries the same scope.
    match /geofences/{fenceId} {
      allow read: if accountActive();
      allow create, update: if isSysAdmin()
        && incoming().keys().hasOnly(['name', 'areaId', 'areaPath', 'kind', 'center', 'radiusM', 'ring', 'provisional', 'auditId'])
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 120
        && incoming().areaId is string
        && incoming().areaPath == get(/databases/$(database)/documents/areas/$(incoming().areaId)).data['path']
        && incoming().provisional is bool
        && ((incoming().kind == 'circle'
              && incoming().center is latlng
              && incoming().radiusM is number && incoming().radiusM >= 20 && incoming().radiusM <= 5000
              && !('ring' in incoming()))
            || (incoming().kind == 'polygon'
              && incoming().ring is list && incoming().ring.size() >= 3 && incoming().ring.size() <= 1000
              && !('center' in incoming()) && !('radiusM' in incoming())))
        && audited('geofences/' + fenceId);
      allow delete: if false;
    }

    // ------------------------------------------------------------ attendance
    // One session per worker per day: attendanceSessions/{uid}_{yyyy-MM-dd}.
    // Location checks run on the phone (no server on the free plan), so the
    // record says evaluatedBy 'device'; these rules make sure it cannot claim
    // more than its own data supports.
    function validCheckIn(c) {
      return c.keys().hasOnly(['at', 'deviceAt', 'lat', 'lng', 'accuracy', 'mocked', 'geofenceId', 'placement',
                               'edgeDistanceM', 'status', 'late', 'reasons', 'eventId'])
        && c.at == request.time
        && c.deviceAt is timestamp
        && c.lat is number && c.lat >= -90 && c.lat <= 90
        && c.lng is number && c.lng >= -180 && c.lng <= 180
        && c.accuracy is number && c.accuracy >= 0
        && c.mocked is bool
        && c.placement in ['inside', 'outside', 'uncertain', 'none']
        && c.status in ['verified', 'flagged']
        && c.late is bool
        && c.reasons is list
        && c.eventId is string
        // "Verified" only with no reasons, a real geofence, inside it, no mock GPS.
        && (c.status == 'flagged'
            || (c.reasons.size() == 0 && c.mocked == false && c.geofenceId is string && c.placement == 'inside'));
    }
    function validCheckOut(c) {
      return c.keys().hasOnly(['at', 'deviceAt', 'lat', 'lng', 'accuracy', 'mocked', 'eventId'])
        && c.at == request.time
        && c.deviceAt is timestamp
        && (c.lat == null || (c.lat is number && c.lat >= -90 && c.lat <= 90))
        && (c.lng == null || (c.lng is number && c.lng >= -180 && c.lng <= 180))
        && c.mocked is bool
        && c.eventId is string;
    }
    match /attendanceSessions/{sessionId} {
      // For queries, rules are checked against the query's filters, where only
      // filtered fields exist; get('uid', null) keeps the officer branch
      // evaluable. A missing uid yields null, which never equals a signed-in uid.
      // A worker may look up their own day's record before it exists (the id is
      // <uid>_<yyyy-MM-dd>); otherwise only existing own records or the
      // officer scopes. The System administrator sees synthetic demo data only.
      allow read: if (signedIn() && resource == null && sessionId.matches(uid() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        || (signedIn() && resource.data.get('uid', null) == uid())
        || officerSees(resource.data)
        || (isSysAdmin() && resource.data.get('synthetic', false) == true);

      allow create: if (isSysAdmin() && demoRecord())
        || incoming().get('role', 'worker') in roles()
        && hasRole(incoming().get('role', 'worker'))
        && incoming().keys().hasOnly(['uid', 'workerName', 'date', 'orgId', 'areaPath', 'checkIn', 'evaluatedBy', 'createdAt', 'role', 'designation'])
        && incoming().get('designation', null) == assignment(incoming().get('role', 'worker')).data.get('designation', null)
        && incoming().uid == uid()
        // The name officers see must be the name on the worker's own account.
        && incoming().workerName == get(/databases/$(database)/documents/accounts/$(uid())).data.get('displayName', '')
        && incoming().date is string
        && sessionId == uid() + '_' + incoming().date
        && isRecentIstDate(incoming().date)
        && incoming().get('orgId', null) == assignment(incoming().get('role', 'worker')).data.get('orgId', null)
        && incoming().evaluatedBy == 'device'
        && incoming().createdAt == request.time
        && validCheckIn(incoming().checkIn)
        && ((incoming().checkIn.get('geofenceId', null) == null
              && roleHomePathOk(incoming().get('role', 'worker'), incoming().areaPath))
            || (incoming().checkIn.geofenceId is string
                && incoming().areaPath == get(/databases/$(database)/documents/geofences/$(incoming().checkIn.geofenceId)).data.areaPath
                && assignment(incoming().get('role', 'worker')).data.areaIds.hasAny(incoming().areaPath)));

      // Check-out once; the check-in itself can never be edited.
      allow update: if signedIn() && resource.data.uid == uid()
        && !('checkOut' in resource.data)
        && changed().hasOnly(['checkOut', 'updatedAt'])
        && incoming().updatedAt == request.time
        && validCheckOut(incoming().checkOut);

      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    // Records made outside any boundary belong to the role's first area (so the
    // person's superiors still see them), or to no area if the role has none.
    function roleHomePathOk(role, path) {
      return (assignment(role).data.areaIds.size() == 0 && path == [])
        || (assignment(role).data.areaIds.size() > 0
            && path == get(/databases/$(database)/documents/areas/$(assignment(role).data.areaIds[0])).data['path']);
    }

    // ------------------------------------------------------ demo data helpers
    // Synthetic demo records: created and removed only by the System
    // administrator, always marked synthetic, always carrying an area path so
    // the normal officer scopes apply to them.
    function demoRecord() {
      return incoming().get('synthetic', false) == true
        && incoming().areaPath is list && incoming().areaPath.size() > 0
        && incoming().uid is string && incoming().uid.matches('demo-.*');
    }

    // Who may create tasks in an area (Phase 1, section 3; switches in config).
    function mayCreateTaskIn(path) {
      return coversPath('officer', path)
        || coversPath('zonal_secretary', path)
        || (exists(/databases/$(database)/documents/config/app)
            && get(/databases/$(database)/documents/config/app).data.get('supervisorsMayCreateTasks', false) == true
            && coversPath('supervisor', path))
        || (exists(/databases/$(database)/documents/config/app)
            && get(/databases/$(database)/documents/config/app).data.get('collectorMayAssignTasks', false) == true
            && hasRole('collector'));
    }
    // Who may review work in an area: AD, Zonal Secretary, supervisor.
    function mayReviewIn(path) {
      return coversPath('officer', path) || coversPath('zonal_secretary', path) || coversPath('supervisor', path);
    }
    function workerCovers(path) {
      return hasRole('worker') && inAreas(assignment('worker').data.areaIds, path);
    }

    // ------------------------------------------------------------------ tasks
    // Work assigned to an AREA (a street, panchayat or block): every worker
    // assigned there sees it. statuses: assigned, in_progress, submitted,
    // approved, rework, cancelled.
    match /tasks/{taskId} {
      allow read: if officerSees(resource.data)
        || workerCovers(resource.data.areaPath)
        || (isSysAdmin() && resource.data.get('synthetic', false) == true);

      allow create: if (isSysAdmin() && incoming().get('synthetic', false) == true
                         && incoming().areaPath is list && incoming().areaPath.size() > 0)
        || (incoming().keys().hasOnly(['title', 'description', 'areaId', 'areaPath', 'priority', 'dueDate', 'status',
                                       'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'synthetic'])
            && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120
            && incoming().description is string && incoming().description.size() <= 2000
            && incoming().areaId is string
            && incoming().areaPath == get(/databases/$(database)/documents/areas/$(incoming().areaId)).data['path']
            && incoming().priority in ['low', 'normal', 'high']
            && incoming().dueDate is string && incoming().dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && incoming().status == 'assigned'
            && incoming().createdBy == uid()
            && incoming().createdAt == request.time && incoming().updatedAt == request.time
            && incoming().synthetic == false
            && mayCreateTaskIn(incoming().areaPath));

      allow update: if
        // A worker in the area starts it or submits it.
        (workerCovers(resource.data.areaPath)
          && changed().hasOnly(['status', 'updatedAt'])
          && incoming().updatedAt == request.time
          && ((resource.data.status in ['assigned'] && incoming().status == 'in_progress')
              || (resource.data.status in ['assigned', 'in_progress', 'rework'] && incoming().status == 'submitted')))
        // A reviewer in the area approves, sends back or cancels it.
        || (mayReviewIn(resource.data.areaPath)
          && changed().hasOnly(['status', 'updatedAt', 'reviewNote', 'reviewedBy'])
          && incoming().updatedAt == request.time
          && incoming().get('reviewedBy', uid()) == uid()
          && incoming().status in ['approved', 'rework', 'cancelled', 'assigned']);

      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    // ------------------------------------------------------------- activities
    // Field work reported by a worker with photos (activityPhotos) and GPS.
    function activityAreaOk(d) {
      return (d.get('taskId', null) is string
              && d.areaPath == get(/databases/$(database)/documents/tasks/$(d.taskId)).data.areaPath
              && inAreas(assignment('worker').data.areaIds, d.areaPath))
        || (d.get('taskId', null) == null && d.get('geofenceId', null) is string
              && d.areaPath == get(/databases/$(database)/documents/geofences/$(d.geofenceId)).data.areaPath
              && assignment('worker').data.areaIds.hasAny(d.areaPath))
        || (d.get('taskId', null) == null && d.get('geofenceId', null) == null && d.areaPath == []);
    }
    match /activities/{activityId} {
      allow read: if (signedIn() && resource.data.get('uid', null) == uid())
        || officerSees(resource.data)
        || (isSysAdmin() && resource.data.get('synthetic', false) == true);

      allow create: if (isSysAdmin() && demoRecord())
        || (hasRole('worker')
          && incoming().keys().hasOnly(['uid', 'workerName', 'date', 'orgId', 'areaPath', 'taskId', 'geofenceId', 'title',
                                        'description', 'lat', 'lng', 'accuracy', 'mocked', 'placement', 'capturedAt',
                                        'photoCount', 'status', 'evaluatedBy', 'createdAt', 'synthetic'])
          && incoming().uid == uid()
          && incoming().workerName == get(/databases/$(database)/documents/accounts/$(uid())).data.get('displayName', '')
          && incoming().date is string && isRecentIstDate(incoming().date)
          && incoming().get('orgId', null) == assignment('worker').data.get('orgId', null)
          && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120
          && incoming().description is string && incoming().description.size() <= 2000
          && (incoming().lat == null || (incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90))
          && (incoming().lng == null || (incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180))
          && incoming().mocked is bool
          && incoming().placement in ['inside', 'outside', 'uncertain', 'none']
          && incoming().capturedAt is timestamp
          && incoming().photoCount is int && incoming().photoCount >= 1 && incoming().photoCount <= 3
          && incoming().status == 'submitted'
          && incoming().evaluatedBy == 'device'
          && incoming().createdAt == request.time
          && incoming().synthetic == false
          && activityAreaOk(incoming())
          // Every photo it claims was saved in this same batch.
          && existsAfter(/databases/$(database)/documents/activityPhotos/$(activityId + '_0'))
          && (incoming().photoCount < 2 || existsAfter(/databases/$(database)/documents/activityPhotos/$(activityId + '_1')))
          && (incoming().photoCount < 3 || existsAfter(/databases/$(database)/documents/activityPhotos/$(activityId + '_2'))));

      // Reviewers in the area decide; the worker's report itself never changes.
      allow update: if mayReviewIn(resource.data.areaPath)
        && resource.data.uid != uid()
        && changed().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
        && incoming().status in ['approved', 'rejected', 'rework']
        && incoming().reviewedBy == uid()
        && incoming().reviewedAt == request.time
        && incoming().reviewNote is string && incoming().reviewNote.size() <= 500
        && (incoming().status == 'approved' || incoming().reviewNote.size() > 0);

      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    // Photos, compressed, one per document (free plan; at most 3 per activity).
    match /activityPhotos/{photoId} {
      allow get: if (signedIn() && resource != null && resource.data.uid == uid())
        || (resource != null && officerSees(get(/databases/$(database)/documents/activities/$(resource.data.activityId)).data))
        || (isSysAdmin() && resource != null && resource.data.get('synthetic', false) == true);
      allow create: if hasRole('worker')
        && incoming().keys().hasOnly(['uid', 'activityId', 'index', 'jpeg', 'sizeBytes', 'createdAt', 'synthetic'])
        && incoming().uid == uid()
        && incoming().index is int && incoming().index >= 0 && incoming().index <= 2
        && photoId == incoming().activityId + '_' + string(incoming().index)
        && incoming().jpeg is bytes && incoming().jpeg.size() > 0 && incoming().jpeg.size() <= 700 * 1024
        && incoming().sizeBytes == incoming().jpeg.size()
        && incoming().createdAt == request.time
        && incoming().synthetic == false
        && !exists(/databases/$(database)/documents/activities/$(incoming().activityId))
        && getAfter(/databases/$(database)/documents/activities/$(incoming().activityId)).data.uid == uid();
      allow update: if false;
      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    // ---------------------------------------------------------- live tracking
    // Live location and routes: Collector (district), the AD, Zonal Secretary
    // and Supervisor covering the worker's area, and organisation admins for
    // their own organisation's workers. Never auditors or the System
    // administrator, never workers (except their own record).
    function liveSees(d) {
      return hasRole('collector')
        || coversPath('officer', d.areaPath)
        || coversPath('zonal_secretary', d.areaPath)
        || coversPath('supervisor', d.areaPath)
        || (d.get('orgId', null) != null && isOrgAdminOf(d.orgId));
    }
    // The worker's home area path: their first assigned area, or [] if none.
    function homePathOk(path) {
      return (assignment('worker').data.areaIds.size() == 0 && path == [])
        || (assignment('worker').data.areaIds.size() > 0
            && path == get(/databases/$(database)/documents/areas/$(assignment('worker').data.areaIds[0])).data['path']);
    }
    function ownWorkerRecord(d) {
      return hasRole('worker')
        && d.uid == uid()
        && d.workerName == get(/databases/$(database)/documents/accounts/$(uid())).data.get('displayName', '')
        && d.get('orgId', null) == assignment('worker').data.get('orgId', null)
        && d.synthetic == false;
    }

    // presence/{uid}: the latest position while on duty.
    match /presence/{presenceId} {
      allow read: if (signedIn() && presenceId == uid())
        || liveSees(resource.data)
        || (isSysAdmin() && resource.data.get('synthetic', false) == true);
      allow create, update: if (isSysAdmin() && demoRecord() && presenceId == incoming().uid)
        || (presenceId == uid()
          && incoming().keys().hasOnly(['uid', 'workerName', 'orgId', 'areaPath', 'lat', 'lng', 'accuracy', 'onDuty',
                                        'geofenceId', 'at', 'synthetic', 'designation'])
          && ownWorkerRecord(incoming())
          && incoming().get('designation', null) == assignment('worker').data.get('designation', null)
          && homePathOk(incoming().areaPath)
          && incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90
          && incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180
          && incoming().accuracy is number
          && incoming().onDuty is bool
          && incoming().at == request.time);
      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    // routes/{uid}_{yyyy-MM-dd}: the day's path (points added while on duty).
    match /routes/{routeId} {
      allow read: if (signedIn() && resource == null && routeId.matches(uid() + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        || (signedIn() && resource.data.get('uid', null) == uid())
        || liveSees(resource.data)
        || (isSysAdmin() && resource.data.get('synthetic', false) == true);
      allow create, update: if (isSysAdmin() && demoRecord())
        || (routeId == uid() + '_' + incoming().date
          && incoming().keys().hasOnly(['uid', 'workerName', 'date', 'orgId', 'areaPath', 'points', 'updatedAt', 'synthetic'])
          && ownWorkerRecord(incoming())
          && homePathOk(incoming().areaPath)
          && incoming().date is string && isRecentIstDate(incoming().date)
          && incoming().points is list && incoming().points.size() <= 3000
          && incoming().updatedAt == request.time);
      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    // visits/{id}: entry and exit of a street boundary, recorded automatically
    // while on duty. Officers in scope see them (including organisation
    // admins and auditors); the worker's app does not show them.
    match /visits/{visitId} {
      allow read: if (signedIn() && resource.data.get('uid', null) == uid())
        || officerSees(resource.data)
        || (isSysAdmin() && resource.data.get('synthetic', false) == true);
      allow create: if (isSysAdmin() && demoRecord())
        || (incoming().keys().hasOnly(['uid', 'workerName', 'date', 'orgId', 'areaPath', 'geofenceId', 'geofenceName',
                                       'enteredAt', 'exitedAt', 'durationMin', 'createdAt', 'closedAt', 'synthetic',
                                       'zonesTotal', 'zonesDone', 'updatedAt'])
          && (incoming().get('zonesTotal', 0) is int && incoming().get('zonesTotal', 0) >= 0 && incoming().get('zonesTotal', 0) <= 50)
          && incoming().get('zonesDone', []) == []
          && ownWorkerRecord(incoming())
          && incoming().date is string && isRecentIstDate(incoming().date)
          && incoming().geofenceId is string
          && incoming().areaPath == get(/databases/$(database)/documents/geofences/$(incoming().geofenceId)).data.areaPath
          && assignment('worker').data.areaIds.hasAny(incoming().areaPath)
          && incoming().enteredAt is timestamp
          && incoming().exitedAt == null && incoming().durationMin == null && incoming().closedAt == null
          && incoming().createdAt == request.time);
      // While inside: cleaning zones reached are added (never removed).
      // The exit (check-out) is added once. The entry never changes.
      // (The System administrator may update synthetic demonstration visits only.)
      allow update: if (isSysAdmin() && resource.data.get('synthetic', false) == true && incoming().synthetic == true)
        || signedIn() && resource.data.uid == uid()
        && resource.data.exitedAt == null
        && incoming().get('zonesDone', []) is list
        && incoming().get('zonesDone', []).size() <= 50
        && incoming().get('zonesDone', []).hasAll(resource.data.get('zonesDone', []))
        && ((changed().hasOnly(['zonesDone', 'updatedAt'])
              && incoming().updatedAt == request.time)
            || (changed().hasOnly(['exitedAt', 'durationMin', 'closedAt', 'zonesDone'])
              && incoming().exitedAt is timestamp && incoming().exitedAt >= resource.data.enteredAt
              && incoming().durationMin is number && incoming().durationMin >= 0
              && incoming().closedAt == request.time));
      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    // ------------------------------------------------------ GPS photo attendance
    // Every staff member with a designation takes GPS photos during the day
    // (schedules in lib/domain/designations.dart). One photo per record.
    match /photoAttendance/{punchId} {
      allow read: if (signedIn() && resource.data.get('uid', null) == uid())
        || officerSees(resource.data)
        || (isSysAdmin() && resource.data.get('synthetic', false) == true);
      allow create: if (isSysAdmin() && demoRecord())
        || (incoming().keys().hasOnly(['uid', 'workerName', 'role', 'designation', 'date', 'orgId', 'areaPath', 'slot',
                                       'lat', 'lng', 'accuracy', 'mocked', 'placement', 'geofenceId', 'status', 'reasons',
                                       'note', 'capturedAt', 'createdAt', 'synthetic'])
          && incoming().role in roles()
          && hasRole(incoming().role)
          && incoming().designation is string
          && incoming().designation == assignment(incoming().role).data.get('designation', null)
          && incoming().uid == uid()
          && incoming().workerName == get(/databases/$(database)/documents/accounts/$(uid())).data.get('displayName', '')
          && incoming().date is string && isRecentIstDate(incoming().date)
          && incoming().get('orgId', null) == assignment(incoming().role).data.get('orgId', null)
          && (incoming().slot == null || (incoming().slot is string && incoming().slot.matches('[0-9]{2}:[0-9]{2}')))
          && incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90
          && incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180
          && incoming().accuracy is number
          && incoming().mocked is bool
          && incoming().placement in ['inside', 'outside', 'uncertain', 'none']
          && incoming().status in ['verified', 'flagged']
          && incoming().reasons is list
          && (incoming().status == 'flagged'
              || (incoming().reasons.size() == 0 && incoming().mocked == false
                  && incoming().geofenceId is string && incoming().placement == 'inside'))
          && ((incoming().geofenceId == null && roleHomePathOk(incoming().role, incoming().areaPath))
              || (incoming().geofenceId is string
                  && incoming().areaPath == get(/databases/$(database)/documents/geofences/$(incoming().geofenceId)).data.areaPath
                  && assignment(incoming().role).data.areaIds.hasAny(incoming().areaPath)))
          && (incoming().note == null || (incoming().note is string && incoming().note.size() <= 200))
          && incoming().capturedAt is timestamp
          && incoming().createdAt == request.time
          && incoming().synthetic == false
          // The photo itself is saved in this same batch.
          && existsAfter(/databases/$(database)/documents/photoAttendancePhotos/$(punchId)));
      allow update: if false;
      allow delete: if isSysAdmin() && resource.data.get('synthetic', false) == true;
    }

    match /photoAttendancePhotos/{punchId} {
      allow get: if (signedIn() && resource != null && resource.data.uid == uid())
        || (resource != null && officerSees(get(/databases/$(database)/documents/photoAttendance/$(punchId)).data));
      allow create: if signedIn()
        && incoming().keys().hasOnly(['uid', 'jpeg', 'sizeBytes', 'createdAt'])
        && incoming().uid == uid()
        && incoming().jpeg is bytes && incoming().jpeg.size() > 0 && incoming().jpeg.size() <= 700 * 1024
        && incoming().sizeBytes == incoming().jpeg.size()
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/photoAttendance/$(punchId))
        && getAfter(/databases/$(database)/documents/photoAttendance/$(punchId)).data.uid == uid();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------- messages
    // District admin messages to all staff or chosen designations / roles.
    match /messages/{messageId} {
      allow read: if accountActive();
      allow create: if isSysAdmin()
        && incoming().keys().hasOnly(['title', 'body', 'priority', 'designations', 'roles', 'createdBy', 'createdByName', 'createdAt'])
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120
        && incoming().body is string && incoming().body.size() > 0 && incoming().body.size() <= 2000
        && incoming().priority in ['normal', 'urgent']
        && incoming().designations is list && incoming().designations.size() <= 20
        && incoming().roles is list && incoming().roles.size() <= 10
        && incoming().createdBy == uid()
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isSysAdmin();
    }

    // ---------------------------------------------------------- cleaning zones
    // Points inside a street the worker must reach (e.g. Sri Ram Nagar Zone 1-8).
    match /cleaningZones/{zoneId} {
      allow read: if accountActive();
      allow create, update: if isSysAdmin()
        && incoming().keys().hasOnly(['name', 'streetFenceId', 'areaPath', 'center', 'radiusM', 'order', 'auditId'])
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80
        && incoming().streetFenceId is string
        && incoming().areaPath == get(/databases/$(database)/documents/geofences/$(incoming().streetFenceId)).data.areaPath
        && incoming().center is latlng
        && incoming().radiusM is number && incoming().radiusM >= 10 && incoming().radiusM <= 100
        && incoming().order is int
        && audited('cleaningZones/' + zoneId);
      allow delete: if isSysAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
